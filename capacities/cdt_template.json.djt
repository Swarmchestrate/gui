{
    {% if not capacity.name and not capacity.author and not capacity.date and not capacity.version %}
    "metadata": {
        {% if capacity.name %}
        "name": {{ capacity.name }},
        {% endif %}
        {% if capacity.author %}
        "author": {{ capacity.author }},
        {% endif %}
        {% if capacity.date %}
        "date": {{ capacity.date }},
        {% endif %}
        {% if capacity.version %}
        "version": {{ capacity.version }}
        {% endif %}
    },
    {% endif %}
    {% if not capacity_instance_types %}
    "service_template": {
        "node_templates": {
            {% for capacity_instance_type in capacity_instance_types %}
            capacity_instance_type_{{ forloop.counter }}: {
                "type": {{ base_instance_type }},
                "capabilities": {
                    "host": {
                        "properties": {
                            "disk-size": {
                                "default": {{ capacity_instance_type.storage_gb }}
                            },
                            "bandwidth": {
                                "default": {{ capacity.bandwidth_mbps }}
                            }
                        }
                    },
                    {% if capacity_operating_systems %}
                    "os": {
                        "properties": {
                            {% with capacity_operating_system=capacity_operating_systems.0 %}
                            {% if capacity_operating_systems.architecture %}
                            "type": {
                                "default": {{ capacity_operating_systems.0.architecture }}
                            },
                            {% endif %}
                            {% if capacity_operating_systems.uuid %}
                            "version": {
                                "default": {{ capacity_operating_system.0.uuid }}
                            },
                            {% endif %}
                            {% if capacity_operating_systems.name %}
                            "distribution": {
                                "default": {{ capacity_operating_system.0.name }}
                            }
                            {% endif %}
                            {% endwith %}
                        }
                    },
                    {% endif %}
                    {% if capacity.connectivity_type %}
                    "network": {
                        "properties": {
                            "type": {
                                "default": {{ capacity.connectivity_type }}
                            }
                        }
                    },
                    {% endif %}
                    {% if capacity_instance_type.price_per_hr %}
                    "pricing": {
                        "properties": {
                            "cost": {
                                "default": {{ capacity_instance_type.price_per_hr }}
                            }
                        }
                    },
                    {% endif %}
                    {% if locality %}
                    "locality": {
                        "properties": {
                            "continent": {
                                "default": {{ locality.continent }}
                            },
                            "country": {
                                "default": {{ locality.country }}
                            },
                            "city": {
                                "default": {{ locality.city }}
                            }
                        }
                    },
                    {% endif %}
                    {% if capacity.powered_type or capacity.energy_type %}
                    "energy": {
                        "properties": {
                            {% if capacity.powered_type %}
                            "powered-type": {
                                "default": {{ capacity.powered_type }}
                            },
                            {% endif %}
                            {% if capacity.energy_type %}
                            "energy-type": {
                                "default": {{ capacity.energy_type }}
                            }
                            {% endif %}
                        }
                    }
                    {% endif %}
                }
            }
            {% if not forloop.last %}
            ,
            {% endif %}
            {% endfor %}
        }
    }
    {% endif %}
}