{% load helpers %}
{% if application.name or application.author or application.version %}
metadata:
  {% if application.name %}
  name: {{ application.name }}
  {% endif %}
  {% if application.version %}
  version: {{ application.version }}
  {% endif %}
  {% if application.author %}
  created_by: {{ application.author }}
  {% endif %}
{% endif %}
service_template:
  node_templates:
    {% if not application_microservices and not application_resources and not application_volumes %}
    {}
    {% else %}
    {% for application_microservice in application_microservices %}
    application-{{ forloop.counter }}:
      type: swch:Application
      {% if application_microservice.container_image %}
      properties:
        {% if application_microservice.container_image %}
        image: {{ application_microservice.container_image }}
        {% endif %}
      {% endif %}
      {% if application_microservice|get_key_value_or_blank_string:'__pk__' in application_volumes %}
      {% with application_microservice_id=application_microservice|get_key_value_or_blank_string:'__pk__' %}
      requirements:
        {% if application_microservice_id in application_volumes %}
        - volume: {{ application_volumes|get_key_value_or_empty_dict:application_microservice_id|get_key_value_or_blank_string:"__name__" }}
        {% endif %}
      {% endwith %}
      {% endif %}
    {% endfor %}
    {% for application_microservice_id, application_volume in application_volumes.items %}
    {{ application_volume|get_key_value_or_empty_dict:'__name__' }}:
      {% if application_volume.volume_type %}
      type: Volume.{{ application_volume.volume_type }}
      {% endif %}
      {% if application_volume.volume_path or application_volume.mount_path %}
      properties:
        {% if application_volume.volume_path %}
        path: {{ application_volume.volume_path }}
        {% endif %}
        {% if application_volume.mount_path %}
        mount_path: {{ application_volume.mount_path }}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% endif %}