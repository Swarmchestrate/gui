{
    "required": [
        "capacity_id",
        "description",
        "resource_provider",
        "capacity_provider",
        "resource_type",
        "connectivity_type",
        "name",
        "ipv4_enabled",
        "ipv6_enabled"
    ],
    "properties": {
        "capacity_id": {
            "description": "Note:\nThis is a Primary Key.<pk/>",
            "format": "integer",
            "type": "integer"
        },
        "created_at": {
            "default": "now()",
            "format": "timestamp without time zone",
            "type": "string"
        },
        "updated_at": {
            "default": "now()",
            "format": "timestamp without time zone",
            "type": "string"
        },
        "description": {
            "format": "text",
            "type": "string"
        },
        "resource_provider": {
            "format": "character varying",
            "maxLength": 255,
            "type": "string"
        },
        "capacity_provider": {
            "format": "character varying",
            "maxLength": 255,
            "type": "string"
        },
        "resource_type": {
            "enum": [
                "Cloud",
                "Edge"
            ],
            "format": "public.resource_type_enum",
            "type": "string"
        },
        "energy_type": {
            "enum": [
                "Green",
                "Brown",
                "Mix"
            ],
            "format": "public.energy_type_enum",
            "type": "string"
        },
        "powered_type": {
            "enum": [
                "Mains",
                "Battery"
            ],
            "format": "public.power_type_enum",
            "type": "string"
        },
        "connectivity_type": {
            "enum": [
                "Ethernet",
                "WiFi",
                "4G",
                "5G",
                "Satellite"
            ],
            "format": "public.connectivity_type_enum",
            "type": "string"
        },
        "locality_id": {
            "description": "Note:\nThis is a Foreign Key to `locality.locality_id`.<fk table='locality' column='locality_id'/>",
            "format": "integer",
            "type": "integer"
        },
        "resource_quota_id": {
            "description": "Note:\nThis is a Foreign Key to `capacity_resource_quota.resource_quota_id`.<fk table='capacity_resource_quota' column='resource_quota_id'/>",
            "format": "integer",
            "type": "integer"
        },
        "energy_consumption_id": {
            "description": "Note:\nThis is a Foreign Key to `capacity_energy_consumption.energy_consumption_id`.<fk table='capacity_energy_consumption' column='energy_consumption_id'/>",
            "format": "integer",
            "type": "integer"
        },
        "price_id": {
            "description": "Note:\nThis is a Foreign Key to `capacity_price.price_id`.<fk table='capacity_price' column='price_id'/>",
            "format": "integer",
            "type": "integer"
        },
        "name": {
            "format": "character varying",
            "type": "string"
        },
        "ssh_port": {
            "default": 22,
            "format": "integer",
            "type": "integer"
        },
        "ssh_user": {
            "format": "character varying",
            "maxLength": 100,
            "type": "string"
        },
        "ipv4_enabled": {
            "format": "boolean",
            "type": "boolean"
        },
        "ipv6_enabled": {
            "format": "boolean",
            "type": "boolean"
        },
        "subnet": {
            "format": "character varying",
            "maxLength": 64,
            "type": "string"
        },
        "explicit_tcp_allow": {
            "format": "text[]",
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "explicit_udp_allow": {
            "format": "text[]",
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "edge_ip": {
            "format": "character varying",
            "maxLength": 64,
            "type": "string"
        },
        "edge_local_ip": {
            "format": "character varying",
            "maxLength": 64,
            "type": "string"
        },
        "ssh_key_name": {
            "format": "character varying",
            "maxLength": 255,
            "type": "string"
        },
        "ssh_auth_method": {
            "format": "character varying",
            "maxLength": 50,
            "type": "string"
        },
        "credentials": {
            "format": "jsonb"
        },
        "cloud": {
            "format": "character varying",
            "maxLength": 50,
            "type": "string"
        },
        "ami": {
            "format": "character varying",
            "maxLength": 64,
            "type": "string"
        },
        "image_id": {
            "format": "character varying",
            "maxLength": 128,
            "type": "string"
        },
        "network_id": {
            "format": "character varying",
            "maxLength": 128,
            "type": "string"
        },
        "project_id": {
            "format": "character varying",
            "maxLength": 128,
            "type": "string"
        },
        "use_block_device": {
            "format": "boolean",
            "type": "boolean"
        },
        "security_group": {
            "format": "character varying",
            "maxLength": 128,
            "type": "string"
        },
        "security_groups": {
            "format": "text[]",
            "items": {
                "type": "string"
            },
            "type": "array"
        }
    },
    "type": "object"
}
